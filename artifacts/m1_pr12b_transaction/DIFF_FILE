+
+bool validSession(const QString& sessionId, QString* error)
+{
+    if (!kSessionId.match(sessionId).hasMatch()) {
+        setError(error, QStringLiteral("E_SHM_OPEN"));
+        return false;
+    }
+    return true;
+}
