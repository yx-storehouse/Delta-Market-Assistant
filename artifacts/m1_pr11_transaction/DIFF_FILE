+        QStringLiteral("-1"),QStringLiteral("+1"),QStringLiteral("1e-2"),QStringLiteral("0,01"),
+        QStringLiteral("1..2"),QStringLiteral("00.1"),QStringLiteral(".1"),QStringLiteral("1."),
