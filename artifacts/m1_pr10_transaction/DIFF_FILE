+void testReadOnlyAndBusy(const QString& path)
+{
+    {
+        SqliteEventStore seedStore;
+        if (!expectOk(seedStore.open(path, noRecovery()), QStringLiteral("readonly_seed_open")) || !seed(seedStore)) return;
