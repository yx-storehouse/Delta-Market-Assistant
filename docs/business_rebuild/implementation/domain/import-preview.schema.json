{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.relink.invalid/business/v1/domain/import-preview.schema.json",
  "title": "Read-only import preview; never an executable configuration",
  "type": "object",
  "properties": {
    "kind": {
      "const": "LegacyImportPreview"
    },
    "source_format": {
      "enum": [
        "schema_v1",
        "bbzps_13"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "encoding": {
      "enum": [
        "UTF-8",
        "UTF-8-BOM",
        "UTF-16LE-BOM",
        "GB18030-explicit"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PreviewRow"
      },
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "maxItems": 1000
    },
    "committable": {
      "const": false
    },
    "extensions": {
      "$ref": "core.schema.json#/$defs/Extensions"
    }
  },
  "required": [
    "kind",
    "source_format",
    "source_sha256",
    "source_bytes",
    "encoding",
    "rows",
    "diagnostics",
    "committable",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "Diagnostic": {
      "type": "object",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "review",
            "info"
          ]
        },
        "code": {
          "$ref": "core.schema.json#/$defs/Id"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "severity",
        "code",
        "line",
        "column",
        "field",
        "message"
      ],
      "additionalProperties": false
    },
    "PreviewRow": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "raw_line": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65536
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 65536
          },
          "maxItems": 13
        },
        "status": {
          "enum": [
            "invalid",
            "review",
            "ready"
          ]
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "core.schema.json#/$defs/TaskRule"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "maxItems": 128
        }
      },
      "required": [
        "line",
        "raw_line",
        "columns",
        "status",
        "candidate",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  }
}
