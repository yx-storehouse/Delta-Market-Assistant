        },
        "mode": {
          "enum": [
            "Replay",
            "Observe"
          ]
        },
        "now_mono_ms": {
          "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/MonoMs"
        },
        "auto_collect": {
          "type": "boolean"
        },
        "target_quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "confirmed_success": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unresolved_reservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "run_id",
        "session_id",
        "clock_domain_id",
        "step_id",
        "cancel_epoch",
        "viewport_generation",
