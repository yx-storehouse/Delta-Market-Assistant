        "run_state": {
          "enum": [
            "Ready",
            "AwaitSchedule",
            "Observe",
            "ConfigureFilter",
            "ScanListings",
            "Evaluate",
            "AwaitCollectReceipt",
            "Watchlist",
            "AwaitDeadline",
            "Revalidate",
            "AwaitConfirm",
            "AwaitReceipt",
            "PersistResult",
            "Reconcile",
            "Recover",
            "Paused",
            "Stopped",
            "Completed"
