  "$defs": {
    "Attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/Id"
        },
        "intent_id": {
          "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/Id"
        },
        "run_id": {
          "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/Id"
        },
        "rule_ref": {
          "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/RuleRef"
        },
        "kind": {
          "enum": [
            "purchase",
            "collection"
          ]
        },
        "state": {
          "enum": [
            "Prepared",
            "Dispatching",
            "Sent",
            "AwaitingReceipt",
            "Unknown",
            "Success",
            "Failed",
            "Cancelled"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "reservation_held": {
          "type": "boolean"
        },
        "dispatch_proof": {
          "enum": [
            "not_dispatched",
            "possibly_dispatched",
            "acknowledged"
          ]
        },
        "receipt_identity": {
          "anyOf": [
            {
              "$ref": "https://schemas.relink.invalid/business/v1/domain/core.schema.json#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempt_id",
        "intent_id",
        "run_id",
        "rule_ref",
        "kind",
        "state",
        "quantity",
        "reservation_held",
        "dispatch_proof",
        "receipt_identity"
      ],
      "additionalProperties": false
    },
    "TaskRun": {
